---
import Base from '@/layouts/Base.astro'
import Portrait from '@/components/Portrait.astro'
import Contact from '@/components/Contact.astro'
import { intro, facts, journey, principles } from '@/data/about'
import { site } from '@/data/site'
---
<Base title="About" description={`About ${site.name} — ${site.title}. My journey from Nigerian fintech to building payments, mobile and AI-automation systems for teams worldwide.`}>
  <!-- Intro -->
  <section class="pt-32 pb-16 sm:pt-40 sm:pb-24">
    <div class="container-x grid items-end gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div class="lg:pb-6">
        <p data-reveal class="eyebrow mb-5">About · {site.name}</p>
        <h1 data-split data-immediate class="text-balance text-[2.6rem] font-semibold leading-[1.03] tracking-[-0.04em] sm:text-6xl">
          {intro.heading}
        </h1>
        {intro.short.map((p) => (
          <p data-reveal class="mt-6 max-w-xl text-pretty text-lg leading-relaxed text-muted">{p}</p>
        ))}
        <dl data-reveal class="mt-10 grid max-w-xl grid-cols-2 gap-x-8 gap-y-5 border-t border-line pt-6">
          {facts.map((f) => (
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-faint">{f.label}</dt>
              <dd class="mt-1.5 text-[15px] font-medium">{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <Portrait eager class="order-first aspect-[4/5] w-full max-w-[520px] lg:order-none lg:max-w-none" />
    </div>
  </section>

  <!-- Journey -->
  <section class="py-20 sm:py-28" aria-labelledby="journey">
    <div class="container-x">
      <p data-reveal class="eyebrow mb-4">The journey</p>
      <h2 id="journey" data-split class="max-w-2xl text-balance text-3xl font-semibold leading-[1.1] tracking-[-0.03em] sm:text-[2.75rem]">
        From local fintech to systems for the world.
      </h2>

      <ol class="mt-16 border-t border-line">
        {journey.map((step, i) => (
          <li data-reveal class="group grid gap-4 border-b border-line py-10 sm:grid-cols-[160px_1fr] sm:gap-10 lg:grid-cols-[220px_1fr_1.4fr]">
            <div class="flex items-baseline gap-3 sm:block">
              <span class="font-mono text-xs text-faint">0{i + 1}</span>
              <p class:list={['font-mono text-sm sm:mt-2', step.year === 'TBD' ? 'text-faint' : 'text-accent-ink']}>{step.year}</p>
            </div>
            <h3 class="text-2xl font-semibold tracking-tight transition-colors duration-500 group-hover:text-accent-ink">{step.title}</h3>
            <p class="max-w-xl leading-relaxed text-muted sm:col-start-2 lg:col-start-auto">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- How I work -->
  <section class="py-20 sm:py-28" aria-labelledby="principles">
    <div class="container-x">
      <p data-reveal class="eyebrow mb-4">How I work</p>
      <h2 id="principles" data-split class="max-w-2xl text-balance text-3xl font-semibold leading-[1.1] tracking-[-0.03em] sm:text-[2.75rem]">
        Principles I bring to every team.
      </h2>
      <div class="mt-14 grid gap-px overflow-hidden rounded-3xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {principles.map((p, i) => (
          <article data-reveal class="bg-bg p-8 transition-colors duration-500 hover:bg-surface">
            <span class="font-mono text-xs text-accent-ink">0{i + 1}</span>
            <h3 class="mt-6 text-lg font-semibold tracking-tight">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Contact />
</Base>
