---
import Base from '@/layouts/Base.astro'
---
<Base title="Not found">
  <section class="grid min-h-[80dvh] place-items-center pt-24 text-center">
    <div class="container-x">
      <p class="eyebrow mb-4">404</p>
      <h1 data-split data-immediate class="text-5xl font-semibold tracking-[-0.04em] sm:text-7xl">This route isn't deployed.</h1>
      <a href="/" class="mt-10 inline-flex rounded-xl bg-accent px-5 py-3 text-sm font-semibold text-accent-fg">Back home</a>
    </div>
  </section>
</Base>
