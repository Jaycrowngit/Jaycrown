---
import Logo from './Logo.astro'
import { site } from '@/data/site'
const year = new Date().getFullYear()
---
<footer class="border-t border-line">
  <div class="container-x flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-4">
      <Logo />
      <span class="text-sm text-faint">© {year} {site.name}</span>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
      <li><a class="hover:text-fg" href={site.links.github} target="_blank" rel="noopener">GitHub</a></li>
      <li><a class="hover:text-fg" href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a class="hover:text-fg" href={`mailto:${site.email}`}>Email</a></li>
    </ul>
  </div>
</footer>
