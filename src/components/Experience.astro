---
import SectionHeader from './SectionHeader.astro'
import { experience } from '@/data/site'
---
<section id="experience" class="py-20 sm:py-28">
  <div class="container-x">
    <SectionHeader eyebrow="Experience" title="Leading teams and owning systems in production." />

    <ol class="relative border-l border-line" data-timeline>
      <!-- progress line drawn on scroll -->
      <span aria-hidden="true" data-timeline-fill
        class="absolute -left-px top-0 h-full w-px origin-top scale-y-0 bg-accent"></span>
      {experience.map((e) => (
        <li data-reveal class="relative pb-14 pl-8 last:pb-0 sm:pl-12">
          <span aria-hidden="true" class="absolute -left-[5px] top-2 size-[9px] rounded-full border-2 border-bg bg-accent ring-1 ring-accent/40"></span>
          <div class="grid gap-4 sm:grid-cols-[1fr_2fr] sm:gap-10">
            <div>
              <p class="font-mono text-xs text-faint">{e.period}</p>
              <h3 class="mt-2 text-lg font-semibold tracking-tight">{e.role}</h3>
              <p class="text-accent-ink">{e.company}</p>
            </div>
            <ul class="space-y-2.5">
              {e.points.map((pt) => (
                <li class="flex gap-3 leading-relaxed text-muted">
                  <span aria-hidden="true" class="mt-[0.7em] h-px w-3 shrink-0 bg-line-strong"></span>{pt}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  document.addEventListener('astro:page-load', () => {
    const line = document.querySelector('[data-timeline-fill]')
    if (!line || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (line) gsap.set(line, { scaleY: 1 })
      return
    }
    gsap.to(line, {
      scaleY: 1, ease: 'none',
      scrollTrigger: { trigger: '[data-timeline]', start: 'top 70%', end: 'bottom 60%', scrub: 0.6 },
    })
  })
</script>
