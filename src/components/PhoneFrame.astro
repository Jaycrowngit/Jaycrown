---
/** Phone mockup. Pass several shots and they cross-fade on a loop. */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  shots: ImageMetadata[]
  alt: string
  eager?: boolean
  sizes?: string
  class?: string
}
const { shots, alt, eager = false, sizes = '(min-width: 1024px) 16vw, 40vw', class: cls = '' } = Astro.props
const cycles = shots.length > 1
---
<div class:list={['rounded-[16%/7.5%] bg-[#0b0c10] p-[3.2%] shadow-[0_40px_80px_-24px_rgb(0_0_0/0.8)] ring-1 ring-white/15', cls]}>
  <div class="relative aspect-[576/1210] overflow-hidden rounded-[13%/6%] bg-black" data-cycle={cycles ? '' : undefined}>
    {shots.map((s, i) => (
      <Image src={s} alt={i === 0 ? alt : ''} aria-hidden={i > 0 ? 'true' : undefined}
        widths={[200, 320, 480]} sizes={sizes}
        class:list={['absolute inset-0 size-full object-cover object-bottom transition-opacity duration-1000',
          i === 0 ? 'opacity-100' : 'opacity-0']}
        loading={eager && i === 0 ? 'eager' : 'lazy'} />
    ))}
    <span aria-hidden="true" class="absolute left-1/2 top-[1.6%] h-[2.4%] w-[30%] -translate-x-1/2 rounded-full bg-black"></span>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
    const ids: number[] = []
    document.querySelectorAll<HTMLElement>('[data-cycle]').forEach((screen, n) => {
      const imgs = screen.querySelectorAll('img')
      let i = 0
      const step = () => {
        imgs[i].classList.replace('opacity-100', 'opacity-0')
        i = (i + 1) % imgs.length
        imgs[i].classList.replace('opacity-0', 'opacity-100')
      }
      // stagger start so multiple phones don't flip in sync
      ids.push(window.setTimeout(() => ids.push(window.setInterval(step, 2800)), n * 900))
    })
    document.addEventListener('astro:before-swap', () => ids.forEach((id) => { clearTimeout(id); clearInterval(id) }), { once: true })
  })
</script>
