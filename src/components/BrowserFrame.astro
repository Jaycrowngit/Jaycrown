---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  src: ImageMetadata
  alt: string
  url?: string
  eager?: boolean
  sizes?: string
  class?: string
}
const { src, alt, url, eager = false, sizes = '(min-width: 1024px) 50vw, 90vw', class: cls = '' } = Astro.props
---
<figure class:list={['overflow-hidden rounded-[10px] border border-white/10 bg-[#15171d] shadow-[0_40px_90px_-30px_rgb(0_0_0/0.75)]', cls]}>
  <div class="flex items-center gap-[5px] border-b border-white/[0.06] px-3 py-2">
    <span class="size-[7px] rounded-full bg-white/15"></span>
    <span class="size-[7px] rounded-full bg-white/15"></span>
    <span class="size-[7px] rounded-full bg-white/15"></span>
    {url ? (
      <span class="mx-auto truncate rounded-md bg-white/[0.06] px-3 py-0.5 font-mono text-[10px] text-white/45">
        {url}
      </span>
    ) : (
      <span aria-hidden="true" class="mx-auto h-[14px] w-1/3 rounded-md bg-white/[0.06]"></span>
    )}
  </div>
  <Image src={src} alt={alt} widths={[480, 800, 1200, 1600]} sizes={sizes}
    class="block aspect-[16/10] w-full object-cover object-top"
    loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
</figure>
