---
import SectionHeader from './SectionHeader.astro'
import SystemMap from './SystemMap.astro'
import { capabilities } from '@/data/site'
---
<section class="py-20 sm:py-28">
  <div class="container-x">
    <SectionHeader eyebrow="Capabilities" title="One engineer across the whole stack — from the phone to the ledger." />

    <div class="grid items-start gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div class="lg:sticky lg:top-28">
        <SystemMap />
      </div>

      <ol class="divide-y divide-line border-y border-line">
        {capabilities.map((c, i) => (
          <li data-reveal class="group grid grid-cols-[auto_1fr] gap-x-6 py-8">
            <span class="pt-1 font-mono text-xs text-faint transition-colors duration-300 group-hover:text-accent-ink">0{i + 1}</span>
            <div>
              <h3 class="text-xl font-semibold tracking-tight">{c.title}</h3>
              <p class="mt-3 leading-relaxed text-muted">{c.body}</p>
              <ul class="mt-5 flex flex-wrap gap-1.5">
                {c.stack.map((s) => <li class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-muted">{s}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
