---
interface Props { eyebrow: string; title: string; id?: string }
const { eyebrow, title } = Astro.props
---
<div class="mb-12 flex flex-col gap-6 sm:mb-16 sm:flex-row sm:items-end sm:justify-between">
  <div class="max-w-2xl">
    <p data-reveal class="eyebrow mb-4">{eyebrow}</p>
    <h2 data-split class="text-balance text-3xl font-semibold leading-[1.1] tracking-[-0.03em] sm:text-[2.75rem]">{title}</h2>
  </div>
  <slot />
</div>
