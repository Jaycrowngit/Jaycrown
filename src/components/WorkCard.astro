---
import type { CollectionEntry } from 'astro:content'
import ProjectMedia from './ProjectMedia.astro'

interface Props {
  project: CollectionEntry<'work'>
  class?: string
  mediaClass?: string
}
const { project, class: cls = '', mediaClass = 'aspect-[16/10]' } = Astro.props
const { id, data } = project
---
<a href={`/work/${id}`} data-reveal data-spotlight
  class:list={['group relative flex flex-col gap-5 rounded-3xl border border-line bg-surface p-3 transition-[transform,border-color] duration-500 ease-out-expo hover:-translate-y-1 hover:border-line-strong', cls]}>
  <!-- cursor spotlight -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100"
    style="background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), color-mix(in oklab, var(--accent) 10%, transparent), transparent 60%)"></div>

  <ProjectMedia project={project} class={mediaClass} />

  <div class="relative flex flex-1 flex-col px-3 pb-3">
    <div class="flex items-start justify-between gap-4">
      <h3 transition:name={`title-${id}`} class="text-xl font-semibold tracking-tight">{data.title}</h3>
      <span class="mt-1 grid size-8 shrink-0 place-items-center rounded-full border border-line text-muted transition-all duration-500 ease-out-expo group-hover:rotate-[-45deg] group-hover:border-accent group-hover:bg-accent group-hover:text-accent-fg">
        <svg class="size-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
      </span>
    </div>
    <p class="mt-1 font-mono text-xs text-faint">{data.role}</p>
    <p class="mt-3 line-clamp-2 text-[15px] leading-relaxed text-muted">{data.summary}</p>
    <ul class="mt-auto flex flex-wrap gap-1.5 pt-5">
      {data.stack.map((s) => (
        <li class="rounded-md border border-line px-2 py-0.5 font-mono text-[11px] text-muted">{s}</li>
      ))}
    </ul>
  </div>
</a>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((el) => {
      el.onpointermove = (e) => {
        const r = el.getBoundingClientRect()
        el.style.setProperty('--mx', `${e.clientX - r.left}px`)
        el.style.setProperty('--my', `${e.clientY - r.top}px`)
      }
    })
  })
</script>
