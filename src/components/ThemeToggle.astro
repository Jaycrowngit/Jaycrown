---
/**
 * Light/Dark toggle. The site follows the device (system) theme automatically;
 * this button lets a viewer override it. Toggling back to the device's own
 * mode clears the override, so the site resumes following the device.
 */
---
<button type="button" data-theme-toggle aria-label="Switch to light mode"
  class="theme-toggle grid size-9 place-items-center rounded-lg text-muted transition-colors hover:bg-surface-2 hover:text-fg">
  <!-- shown in dark mode: switch to light -->
  <svg class="icon-sun size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <!-- shown in light mode: switch to dark -->
  <svg class="icon-moon size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
  </svg>
</button>

<style>
  .theme-toggle .icon-moon { display: none; }
  :global(html[data-theme='light']) .theme-toggle .icon-sun { display: none; }
  :global(html[data-theme='light']) .theme-toggle .icon-moon { display: block; }
</style>

<script>
  type Theme = 'light' | 'dark'
  type Pref = Theme | 'system'
  const api = () => (window as unknown as { __theme: { set(p: Pref): void } }).__theme
  const current = (): Theme => (document.documentElement.dataset.theme === 'light' ? 'light' : 'dark')
  const deviceTheme = (): Theme => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')

  const label = (btn: HTMLButtonElement) => {
    const next = current() === 'dark' ? 'light' : 'dark'
    btn.setAttribute('aria-label', `Switch to ${next} mode`)
    btn.title = `Switch to ${next} mode`
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      label(btn)
      btn.onclick = () => {
        const next: Theme = current() === 'dark' ? 'light' : 'dark'
        // Matching the device again → go back to following it automatically
        const apply = () => { api().set(next === deviceTheme() ? 'system' : next); label(btn) }
        if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.startViewTransition(apply)
        } else apply()
      }
    })
    // Keep the label right if the device theme changes while the page is open
    matchMedia('(prefers-color-scheme: light)').onchange = () =>
      document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(label)
  })
</script>
